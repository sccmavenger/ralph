{
  "project": "MSF Companion — Tower Planner Ability-Aware Scoring",
  "branchName": "ralph/tower-planner-ability-aware-scoring",
  "description": "Upgrade the tower planner solver from pure trait-filter + power × safety_margin to a composite score that also considers faction synergy, opponent ability counters, and role balance. A team labeled 'Strong pick' should actually be a strong pick. Triggered by a real loss on WAR TOWER (OMEGA) cell 3 where the solver returned +56% margin / 'Strong pick' and the user lost twice in a row.",
  "userStories": [
    {
      "id": "US-001",
      "title": "Faction-passive map constant",
      "description": "As the solver, I need a curated map of faction passives (trait → minimum members for activation) so faction-synergy scoring has data to work with.",
      "acceptanceCriteria": [
        "New file src/lib/tower-scoring-data.ts exports FACTION_PASSIVES: Record<string, { trait: string; minMembers: number; description: string }>",
        "Includes at least 12 entries (Asgardian, Avenger, X-Men, Inhuman, A-Force, Wakandan, Hand, Defenders, Symbiote, Black Order, Brotherhood, Mercs for Money)",
        "Trait values match the canonical trait strings already used in src/lib/characters (verify by grep)",
        "Each entry has a one-line human description used later in the 'Why this team?' breakdown",
        "Typecheck passes"
      ],
      "priority": 1,
      "passes": true,
      "notes": "Implemented in src/lib/tower-scoring-data.ts with 12 faction entries (Asgardian, Avenger, X-Men, Inhuman, A-Force, Wakandan, Hand, Defender, Symbiote, Black Order, Brotherhood, Mercs for Money). No canonical trait enum exists in src/lib/characters (no such directory); used MSF-conventional human-readable trait strings (matches 'X-Men' / 'Mutant' style seen in existing room tests). Normalization, if needed, will live in the US-002 scoring function."
    },
    {
      "id": "US-002",
      "title": "factionSynergyScore pure function",
      "description": "As the solver, I need a pure function that scores a team 0–100 on faction synergy so it can be blended into the composite score.",
      "acceptanceCriteria": [
        "New file src/lib/tower-scoring.ts exports factionSynergyScore(team: Character[], factionPassives: FactionPassiveMap): number",
        "Returns 0 when no passive activates, scales up when one passive activates with exactly minMembers, peaks at 100 when ≥2 passives activate or one passive has all 5 members",
        "Pure: no IO, no side effects",
        "Unit tests in src/lib/__tests__/tower-scoring.test.ts cover: empty team, no synergy, exactly-threshold synergy, full-team synergy, multi-passive overlap",
        "Tests pass",
        "Typecheck passes"
      ],
      "priority": 2,
      "passes": true,
      "notes": "Implemented in src/lib/tower-scoring.ts. Score = sum of per-activated-passive scores, where each activated passive contributes 50 + (count - minMembers)/(5 - minMembers) * 50 (capped at 100 per passive). Multi-passive overlap saturates at 100. Tests co-located at src/lib/tower-scoring.test.ts (not __tests__/) to match existing repo pattern (tower-solver.test.ts etc.). 8/8 tests pass; typecheck + ESLint clean."
    },
    {
      "id": "US-003",
      "title": "Opponent ability-tag extractor with cache",
      "description": "As the solver, I need ability tags for every opponent unit so the counter-score can reward our characters that counter those tags.",
      "acceptanceCriteria": [
        "src/lib/tower-ability-tags.ts exports extractAbilityTags(characterIds: string[]): Promise<Record<string, string[]>>",
        "Uses existing getCharacterAbilities helper (grep for it under src/lib) — do not re-implement the API call",
        "Heuristic tagger maps ability free-text to a fixed tag vocabulary including at least: revive, heal, bleed, disrupted, slow, blind, offense_down, defense_down, stun, ability_block, dispel, taunt, counter_attack, immune_to_bleed, heal_block, revive_block",
        "In-memory + localStorage cache keyed by character id + ability hash; cache invalidates when ability hash changes",
        "Unit tests cover at least 3 known characters with expected tags",
        "Tests pass",
        "Typecheck passes"
      ],
      "priority": 3,
      "passes": true,
      "notes": "Implemented in src/lib/tower-ability-tags.ts. Note: PRD AC referenced an existing `getCharacterAbilities` helper but no such helper exists under src/lib (verified by grep). Used the canonical low-level `msfApiFetch` directly (same pattern as tower-enemy-fetcher.ts and upgrade-calculator.ts) hitting `/game/v1/characters/{id}?charInfo=full&abilityKits=full`. Heuristic tagger emits all 16 vocabulary tags; specific-qualifier patterns (immune_to_bleed, heal_block, revive_block) checked before their broader siblings. Cache: in-memory Map + localStorage (key tower-ability-tags-cache-v1), invalidated when meta.hashes.chars changes (mirrors tower-enemy-fetcher). 7/7 tests pass in src/lib/tower-ability-tags.test.ts; typecheck + ESLint clean."
    },
    {
      "id": "US-004",
      "title": "counterScore pure function + counter map",
      "description": "As the solver, I need a pure function that scores a team 0–100 on how well its ability kit counters the opponent's ability kit.",
      "acceptanceCriteria": [
        "src/lib/tower-scoring-data.ts exports COUNTER_MAP: Record<string, { counteredBy: string[]; weight: number }> with at least 12 entries covering revive, heal, bleed, disrupted, slow, blind, offense_down, defense_down, stun, ability_block, taunt, dispel",
        "src/lib/tower-scoring.ts exports counterScore(teamTags: Record<string, string[]>, opponentTags: string[]): number returning 0–100",
        "Score scales with weighted matches: each opponent tag matched by ≥1 team character contributes its weight; saturates at 100",
        "Pure: no IO",
        "Unit tests cover: no opponent tags → 0, full counter coverage → 100, partial coverage → intermediate, no team coverage of strong opp kit → low",
        "Tests pass",
        "Typecheck passes"
