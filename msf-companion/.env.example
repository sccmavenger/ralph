# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/msf_companion?schema=public"

# Session encryption secret (minimum 32 characters)
SESSION_SECRET="change-me-to-a-random-32-char-string!"

# Scopely OAuth
SCOPELY_CLIENT_ID="your-scopely-client-id"
SCOPELY_CLIENT_SECRET="your-scopely-client-secret"
SCOPELY_REDIRECT_URI="http://localhost:3000/api/auth/callback"

# MSF API key (server-side only — never expose to browser)
MSF_API_KEY="your-msf-api-key"

# Set to PREMIUM to bypass paywall for testing
# OVERRIDE_TIER=PREMIUM

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_PRICE_ID="price_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Resend email delivery
RESEND_API_KEY="re_..."
EMAIL_FROM="MSF Companion <info@themsftoolkit.com>"
EMAIL_REPLY_TO="info@themsftoolkit.com"
RESEND_WEBHOOK_SECRET="whsec_..."
EMAIL_UNSUBSCRIBE_SECRET="change-me-to-a-dedicated-random-secret"
# Scheduled marketing is fail-closed: disabled | test | live
EMAIL_AUTOMATION_MODE="disabled"
EMAIL_AUTOMATION_TEST_RECIPIENT="commander@example.com"
CRON_SECRET="change-me-to-a-random-cron-secret"

# Admin Panel
ADMIN_PASSWORD="change-me-to-a-strong-password"
ADMIN_SESSION_SECRET="change-me-to-a-random-32-char-string!"

# Discord Bot (announcements)
DISCORD_BOT_TOKEN=""
DISCORD_ANNOUNCEMENT_CHANNEL_ID=""
