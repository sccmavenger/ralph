{
  // Typechecks only the Cloudflare Worker front door. Kept separate from the
  // app's tsconfig.json because this code targets workerd (Cloudflare runtime
  // globals, "cloudflare:workers") while the app targets Node + the DOM.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["./worker-configuration.d.ts"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true
  },
  "include": ["src/worker/**/*.ts", "worker-configuration.d.ts"],
  "exclude": ["node_modules"]
}
